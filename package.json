{
  "name": "kafka-visual-demo",
  "version": "1.0.0",
  "description": "Interactive visualization of Apache Kafka concepts with real-time message flow, consumer groups, and comprehensive metrics",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "webpack --mode production",
    "dev-build": "webpack --mode development",
    "test": "node test/test-suite.js",
    "deploy": "npm run build && npm start",
    "docker:build": "docker build -t kafka-visual-demo .",
    "docker:run": "docker run -p 3000:3000 kafka-visual-demo",
    "docker:compose": "docker-compose up -d"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "uuid": "^9.0.0",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "css-loader": "^6.8.1",
    "style-loader": "^3.3.3",
    "html-webpack-plugin": "^5.5.3"
  },
  "keywords": [
    "kafka",
    "visualization",
    "demo",
    "real-time",
    "websocket",
    "producer",
    "consumer",
    "topic",
    "partition",
    "message-queue",
    "streaming",
    "education",
    "simulation"
  ],
  "author": "Kafka Visual Demo",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/kafka-visual-demo.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/kafka-visual-demo/issues"
  },
  "homepage": "https://github.com/your-username/kafka-visual-demo#readme"
}